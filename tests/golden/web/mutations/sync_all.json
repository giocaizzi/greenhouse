{
 "body_lines": [
  "<article class=\"card card--flush result-panel\">",
  "  <div class=\"card__head\">",
  "    <div class=\"row\" style=\"gap: var(--sp-3);\">",
  "      <span class=\"badge-ok\">",
  "        <svg class=\"icon icon--xs\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-check\"></use></svg>",
  "        Synced",
  "      </span>",
  "      <h3 class=\"card__title\">Sync result</h3>",
  "    </div>",
  "  </div>",
  "  <div class=\"card__body\">",
  "    ",
  "      <p>",
  "        <span class=\"mono\">0</span> readings",
  "        <small class=\"muted\">(0 new · 0 live)</small>",
  "      </p>",
  "    ",
  "    ",
  "      <details>",
  "        <summary><span class=\"badge-warning\">1 error</span></summary>",
  "        <ul><li>No cloud connection</li></ul>",
  "      </details>",
  "    ",
  "  </div>",
  "</article>"
 ],
