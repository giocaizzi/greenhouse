{
 "body_lines": [
  "<!DOCTYPE html>",
  "<html lang=\"en\" data-theme=\"dark\">",
  "<head>",
  "  <meta charset=\"utf-8\">",
  "  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">",
  "  <meta name=\"color-scheme\" content=\"light dark\">",
  "  <title>Error 400 · Greenhouse</title>",
  "",
  "  <link rel=\"preload\" href=\"/static/fonts/Geist[wght].woff2\" as=\"font\" type=\"font/woff2\" crossorigin>",
  "  <link rel=\"preload\" href=\"/static/fonts/GeistMono[wght].woff2\" as=\"font\" type=\"font/woff2\" crossorigin>",
  "  <link rel=\"stylesheet\" href=\"/static/app.css\">",
  "",
  "  <script>",
  "    // Early theme application — runs before body paint to avoid flash.",
  "    // The <html> tag is already server-rendered with the persisted preference;",
  "    // localStorage (if present) takes precedence for instant client paint.",
  "    (function () {",
  "      try {",
  "        var t = localStorage.getItem('theme');",
  "        if (t) document.documentElement.setAttribute('data-theme', t);",
  "      } catch (e) {}",
  "    })();",
  "  </script>",
  "",
  "  <script src=\"https://unpkg.com/htmx.org@2.0.3\" defer></script>",
  "  <script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js\" defer></script>",
  "  <script src=\"https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js\" defer></script>",
  "  <script src=\"https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js\" defer></script>",
  "  <script src=\"/static/app.js\" defer></script>",
  "</head>",
  "<body>",
  "",
  "<a class=\"skip-link\" href=\"#main\">Skip to content</a>",
  "",
  "<div id=\"page-progress\" class=\"page-progress\" aria-hidden=\"true\"></div>",
  "",
  "",
  "",
  "",
  "",
  "",
  "<header class=\"topbar\">",
  "  <div class=\"container topbar__inner\">",
  "    <a href=\"/\" class=\"brand\" aria-label=\"Irrigation home\">",
  "      <span class=\"brand__mark\"><svg class=\"icon\"><use href=\"/static/icons/sprite.svg#i-leaf\"></use></svg></span>",
  "      Irrigation",
  "    </a>",
  "    <nav class=\"topnav\" aria-label=\"Primary\">",
  "      <a href=\"/\">Today</a>",
  "      <a href=\"/clusters\">Spaces</a>",
  "      <a href=\"/activity\">Activity</a>",
  "      <a href=\"/scheduler\">Scheduler</a>",
  "      <details class=\"topnav__more\">",
  "        <summary aria-label=\"More pages\">More</summary>",
  "        <div class=\"topnav__menu\">",
  "          <a href=\"/vacation\">Vacation</a>",
  "          <a href=\"/health\">Health</a>",
  "          <a href=\"/quality\">Data quality</a>",
  "          <a href=\"/preferences\">Preferences</a>",
  "        </div>",
  "      </details>",
  "    </nav>",
  "    <span class=\"topbar__spacer\"></span>",
  "    <a",
  "      class=\"bell\"",
  "      href=\"/alerts\"",
  "      aria-label=\"Open alerts\"",
  "      hx-get=\"/alerts/badge\"",
  "      hx-trigger=\"load, every 60s\"",
  "      hx-swap=\"innerHTML\">",
  "      <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-bell\"></use></svg>",
  "    </a>",
  "    <button",
  "      class=\"icon-btn\"",
  "      type=\"button\"",
  "      aria-label=\"Open command palette\"",
  "      title=\"Search (⌘K)\"",
  "      onclick=\"window.openCmdK && window.openCmdK()\">",
  "      <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-magnifying-glass\"></use></svg>",
  "    </button>",
  "    <button",
  "      id=\"theme-toggle\"",
  "      class=\"icon-btn\"",
  "      type=\"button\"",
  "      aria-label=\"Toggle theme\"",
  "      title=\"Toggle theme\"",
  "      onclick=\"(function(){var h=document.documentElement;var cur=h.getAttribute('data-theme');var next=cur==='light'?'dark':(cur==='dark'?'light':(window.matchMedia('(prefers-color-scheme: light)').matches?'dark':'light'));h.setAttribute('data-theme',next);try{localStorage.setItem('theme',next);}catch(e){}if(window.__rerenderCharts){window.__rerenderCharts();}try{fetch('/preferences/theme',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'theme='+encodeURIComponent(next)});}catch(e){}})()\">",
  "      <svg class=\"icon icon-moon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-moon\"></use></svg>",
  "      <svg class=\"icon icon-sun\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-sun\"></use></svg>",
  "    </button>",
  "    ",
  "    <form method=\"post\" action=\"/logout\" class=\"inline\">",
  "      <button class=\"icon-btn\" type=\"submit\" aria-label=\"Sign out\" title=\"Sign out\">",
  "        <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-x\"></use></svg>",
  "        <span class=\"visually-hidden\">Sign out</span>",
  "      </button>",
  "    </form>",
  "    ",
  "  </div>",
  "</header>",
  "",
  "",
  "<main class=\"container\" id=\"main\">",
  "  ",
  "<article class=\"card error-panel\">",
  "  <div class=\"card__head\">",
  "    <h3 class=\"card__title\">",
  "      <span class=\"badge-danger\">Error 400</span>",
  "    </h3>",
  "  </div>",
  "  <div class=\"card__body\">",
  "    <p>Invalid hour value</p>",
  "    ",
  "      <div class=\"mt-4\">",
  "        <a href=\"/\" class=\"btn\">",
  "          <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-arrow-right\"></use></svg>",
  "          Back to dashboard",
  "        </a>",
  "      </div>",
  "    ",
  "  </div>",
  "</article>",
  "",
  "</main>",
  "",
  "",
  "<dialog id=\"cmdk-dialog\" class=\"cmdk\" aria-label=\"Command palette\">",
  "  <div class=\"cmdk__panel\" role=\"dialog\" aria-modal=\"true\">",
  "    <input",
  "      type=\"search\"",
  "      class=\"cmdk__input\"",
  "      placeholder=\"Search clusters, plants, sensors…\"",
  "      autocomplete=\"off\" autocorrect=\"off\" spellcheck=\"false\"",
  "      hx-get=\"/api/v1/search\"",
  "      hx-trigger=\"keyup changed delay:120ms\"",
  "      hx-target=\"#cmdk-list\"",
  "      hx-swap=\"innerHTML\"",
  "      name=\"q\"",
  "      aria-label=\"Search\">",
  "    <div id=\"cmdk-list\" class=\"cmdk__list\" role=\"listbox\"></div>",
  "    <div class=\"cmdk__hint\">",
  "      <span><span class=\"cmdk__kbd\">↵</span> open</span>",
  "      <span><span class=\"cmdk__kbd\">esc</span> close</span>",
  "    </div>",
  "  </div>",
  "</dialog>",
  "",
  "",
  "<div id=\"toasts\" class=\"toasts\" aria-live=\"polite\" aria-atomic=\"false\"></div>",
  "",
  "<footer class=\"container\">",
  "  <div class=\"footer__row\">",
  "    ",
  "    <a id=\"health-badge\"",
  "       href=\"/health\"",
  "       aria-label=\"System health\"",
  "       hx-get=\"/health/badge\"",
  "       hx-trigger=\"load, every 60s\"",
  "       hx-swap=\"innerHTML\">…</a>",
  "    ",
  "    <span class=\"footer__meta\">",
  "      <span>greenhouse</span>",
  "      ",
  "      <span class=\"sep\" aria-hidden=\"true\"></span>",
  "      <span title=\"App version\">v<VERSION></span>",
  "      ",
  "      <span class=\"sep\" aria-hidden=\"true\"></span>",
  "      <span title=\"Page rendered\">2026-04-15 10:00</span>",
  "    </span>",
  "  </div>",
  "</footer>",
  "",
  "",
  "<nav class=\"mobile-nav\" aria-label=\"Mobile navigation\">",
  "  <a class=\"mobile-nav__item\" href=\"/\">",
  "    <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-pulse\"></use></svg>",
  "    Today",
  "  </a>",
  "  <a class=\"mobile-nav__item\" href=\"/clusters\">",
  "    <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-leaf\"></use></svg>",
  "    Spaces",
  "  </a>",
  "  <a class=\"mobile-nav__item\" href=\"/activity\">",
  "    <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-clock\"></use></svg>",
  "    Activity",
  "  </a>",
  "  <a class=\"mobile-nav__item\" href=\"/alerts\">",
  "    <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-bell\"></use></svg>",
  "    Alerts",
  "  </a>",
  "  <details class=\"mobile-nav__more\">",
  "    <summary class=\"mobile-nav__item\">",
  "      <svg class=\"icon\" aria-hidden=\"true\"><use href=\"/static/icons/sprite.svg#i-list\"></use></svg>",
  "      More",
  "    </summary>",
  "    <div class=\"mobile-nav__sheet\" aria-label=\"More pages\">",
  "      <a href=\"/scheduler\">Scheduler</a>",
  "      <a href=\"/vacation\">Vacation</a>",
  "      <a href=\"/health\">Health</a>",
  "      <a href=\"/quality\">Data quality</a>",
  "      <a href=\"/preferences\">Preferences</a>",
  "    </div>",
  "  </details>",
  "</nav>",
  "<script>",
  "  (function () {",
  "    var path = location.pathname;",
  "    document.querySelectorAll('.mobile-nav__item').forEach(function (a) {",
  "      var href = a.getAttribute('href');",
  "      if (href === '/' ? path === '/' : path === href || path.startsWith(href + '/')) {",
  "        a.setAttribute('aria-current', 'page');",
  "      }",
  "    });",
  "  })();",
  "</script>",
  "",
  "",
  "</body>",
  "</html>"
 ],
 "db_effect": {},
 "device_calls": {
  "irrigator": [],
  "sensor": []
 },
 "headers": {
  "content-type": "text/html; charset=utf-8"
 },
 "request": {
  "form": {
   "quiet_start_hour": "noon"
  },
  "headers": {},
  "method": "POST",
  "url": "/clusters/1/config"
 },
 "status": 400,
 "templates": [
  [
   "error_page.html",
   [
    "active_vacation",
    "app_version",
    "auth_enabled",
    "detail",
    "dry_run_global",
    "is_hx",
    "now_text",
    "request",
    "scheduler_paused",
    "show_chrome",
    "status_code",
    "theme"
   ]
  ]
 ]
}
