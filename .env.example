# Tuya Cloud API credentials (required)
TUYA_CLIENT_ID=your_client_id
TUYA_CLIENT_SECRET=your_client_secret
TUYA_REGION=eu  # eu | us | cn | in

# Optional: override default server settings
# IRRIGATION_DB_URL=sqlite:///data/irrigation.db
# IRRIGATION_PLANT_DB_PATH=/path/to/plant_database.json
# IRRIGATION_HOST=0.0.0.0
# IRRIGATION_PORT=8000
# IRRIGATION_SYNC_INTERVAL_MINUTES=30
# IRRIGATION_CHECK_INTERVAL_HOURS=6
