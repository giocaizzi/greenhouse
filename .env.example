# Tuya Cloud API credentials (required)
TUYA_CLIENT_ID=your_client_id
TUYA_CLIENT_SECRET=your_client_secret
TUYA_REGION=eu  # eu | us | cn | in

# Local device IP for hybrid local+cloud control (required for duration control)
# TUYA_DEVICE_IP=192.168.1.x

# Optional: override default paths
# IRRIGATION_DATA_DIR=/path/to/data
# IRRIGATION_DB_PATH=/path/to/irrigation.db
