# All server and CLI settings use GREENHOUSE_* names below; legacy
# IRRIGATION_* and bare secret spellings (MCP_TOKEN) are ignored, with a
# startup warning naming each one that is still set.

# Tuya Cloud API credentials (required)
TUYA_CLIENT_ID=your_client_id
TUYA_CLIENT_SECRET=your_client_secret
TUYA_REGION=eu  # eu | us | cn | in

# REQUIRED for /mcp; unset, empty or whitespace-only → /mcp returns 503; generate with `openssl rand -hex 32`
GREENHOUSE_MCP_TOKEN=

# ── Web / API authentication ────────────────────────────────────────────────
# REQUIRED when GREENHOUSE_AUTH_ENABLED is on (default true).
# Generate with `openssl rand -hex 32`. Rotating it invalidates all sessions.
GREENHOUSE_AUTH_SECRET_KEY=
# First-run bootstrap. On startup, if no users exist these credentials seed
# one. After that the values are ignored. Empty here ⇒ no automatic seeding.
GREENHOUSE_AUTH_ADMIN_USERNAME=
GREENHOUSE_AUTH_ADMIN_PASSWORD=
# Set to false ONLY for local dev or password-recovery — opens every endpoint.
# GREENHOUSE_AUTH_ENABLED=true
# GREENHOUSE_AUTH_TOKEN_TTL_MINUTES=1440
# Set to true when running behind HTTPS so the session cookie carries Secure.
# GREENHOUSE_AUTH_COOKIE_SECURE=false

# Optional: push notifications via ntfy (unset -> no pushes; categories are
# toggled per user in Preferences). The server URL must be http:// or https://
# with a host, otherwise the server refuses to start.
# GREENHOUSE_NTFY_SERVER_URL=https://ntfy.sh
# GREENHOUSE_NTFY_TOPIC=
# GREENHOUSE_NTFY_TOKEN=

# Optional: override default server settings
# GREENHOUSE_DB_URL=sqlite:///data/irrigation.db
# GREENHOUSE_PLANT_DB_PATH=/path/to/plant_database.json
# Bind address. Default 127.0.0.1 (loopback only — the API and /mcp can switch
# pumps on). Set 0.0.0.0 to listen on every interface; the Docker image and
# docker-compose.yml already do, because the container must for the published port.
# GREENHOUSE_HOST=127.0.0.1
# GREENHOUSE_PORT=8000
# Open-Meteo forecast location (default: Milan).
# GREENHOUSE_WEATHER_LAT=45.464
# GREENHOUSE_WEATHER_LON=9.189
# Set to false to run without background jobs (no automatic checks/syncs).
# GREENHOUSE_ENABLE_SCHEDULER=true
# Minutes between Tuya Cloud sensor syncs (default 180; must be > 0).
# GREENHOUSE_SYNC_INTERVAL_MINUTES=180
# Cron `hour` field for check_all — e.g. *, 0,6,12,18, */3, 6-20/2. Defaults
# to every hour; cooldown in constants.py (MIN_COOLDOWN_HOURS) handles
# actuation spacing. Validated at startup (invalid -> server refuses to start).
# (The old IRRIGATION_CHECK_INTERVAL_HOURS is no longer read: use */N here.)
# GREENHOUSE_CHECK_CRON_HOURS=*
