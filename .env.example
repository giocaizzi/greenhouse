# Tuya Cloud API credentials (required)
TUYA_CLIENT_ID=your_client_id
TUYA_CLIENT_SECRET=your_client_secret
TUYA_REGION=eu  # eu | us | cn | in

# REQUIRED for /mcp; unset → /mcp returns 503; generate with `openssl rand -hex 32`
GREENHOUSE_MCP_TOKEN=

# ── Web / API authentication ────────────────────────────────────────────────
# REQUIRED when IRRIGATION_AUTH_ENABLED is on (default true).
# Generate with `openssl rand -hex 32`. Rotating it invalidates all sessions.
GREENHOUSE_AUTH_SECRET_KEY=
# First-run bootstrap. On startup, if no users exist these credentials seed
# one. After that the values are ignored. Empty here ⇒ no automatic seeding.
GREENHOUSE_AUTH_ADMIN_USERNAME=
GREENHOUSE_AUTH_ADMIN_PASSWORD=
# Set to false ONLY for local dev or password-recovery — opens every endpoint.
# IRRIGATION_AUTH_ENABLED=true
# IRRIGATION_AUTH_TOKEN_TTL_MINUTES=1440
# Set to true when running behind HTTPS so the session cookie carries Secure.
# IRRIGATION_AUTH_COOKIE_SECURE=false

# Optional: override default server settings
# IRRIGATION_DB_URL=sqlite:///data/irrigation.db
# IRRIGATION_PLANT_DB_PATH=/path/to/plant_database.json
# IRRIGATION_HOST=0.0.0.0
# IRRIGATION_PORT=8000
# IRRIGATION_SYNC_INTERVAL_MINUTES=30
# Hours list (cron syntax) — defaults to every hour; cooldown in
# constants.py (MIN_COOLDOWN_HOURS) handles actuation spacing.
# IRRIGATION_CHECK_CRON_HOURS=*
# Deprecated: legacy interval-trigger config. If set (and the cron var
# above is at its default), it is translated to `*/N` on startup and a
# warning is logged. Migrate to IRRIGATION_CHECK_CRON_HOURS.
# IRRIGATION_CHECK_INTERVAL_HOURS=
